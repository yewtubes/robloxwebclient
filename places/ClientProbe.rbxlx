<roblox version="4">
	<!-- The platform's default experience: the same layout as Studio's Baseplate template
	     (a 2048x16x2048 baseplate with the grid texture, a spawn, default lighting). -->
	<Item class="Workspace" referent="RBX0">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="FilteringEnabled">true</bool>
		</Properties>
		<Item class="Part" referent="RBX1">
			<Properties>
				<string name="Name">Baseplate</string>
				<bool name="Anchored">true</bool>
				<bool name="Locked">true</bool>
				<Color3uint8 name="Color3uint8">4284177769</Color3uint8>
				<token name="Material">256</token>
				<CoordinateFrame name="CFrame">
					<X>0</X><Y>-8</Y><Z>0</Z>
					<R00>1</R00><R01>0</R01><R02>0</R02>
					<R10>0</R10><R11>1</R11><R12>0</R12>
					<R20>0</R20><R21>0</R21><R22>1</R22>
				</CoordinateFrame>
				<Vector3 name="size"><X>2048</X><Y>16</Y><Z>2048</Z></Vector3>
				<token name="TopSurface">0</token>
				<token name="BottomSurface">0</token>
			</Properties>
			<Item class="Texture" referent="RBX2">
				<Properties>
					<string name="Name">Texture</string>
					<Content name="Texture"><url>rbxassetid://6372755229</url></Content>
					<token name="Face">1</token>
					<float name="StudsPerTileU">8</float>
					<float name="StudsPerTileV">8</float>
					<Color3 name="Color3"><R>0</R><G>0</G><B>0</B></Color3>
					<float name="Transparency">0.8</float>
				</Properties>
			</Item>
		</Item>
		<Item class="SpawnLocation" referent="RBX3">
			<Properties>
				<string name="Name">SpawnLocation</string>
				<bool name="Anchored">true</bool>
				<Color3uint8 name="Color3uint8">4288914085</Color3uint8>
				<token name="Material">256</token>
				<CoordinateFrame name="CFrame">
					<X>0</X><Y>0.5</Y><Z>0</Z>
					<R00>1</R00><R01>0</R01><R02>0</R02>
					<R10>0</R10><R11>1</R11><R12>0</R12>
					<R20>0</R20><R21>0</R21><R22>1</R22>
				</CoordinateFrame>
				<Vector3 name="size"><X>12</X><Y>1</Y><Z>12</Z></Vector3>
				<token name="TopSurface">0</token>
				<token name="BottomSurface">0</token>
				<int name="Duration">0</int>
			</Properties>
			<Item class="Decal" referent="RBX4">
				<Properties>
					<string name="Name">Decal</string>
					<Content name="Texture"><url>rbxasset://textures/SpawnLocation.png</url></Content>
					<token name="Face">1</token>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="Lighting" referent="RBX5">
		<Properties>
			<string name="Name">Lighting</string>
			<float name="Brightness">2</float>
			<float name="ClockTime">14.5</float>
			<Color3 name="Ambient"><R>0.27450982</R><G>0.27450982</G><B>0.27450982</B></Color3>
			<Color3 name="OutdoorAmbient"><R>0.27450982</R><G>0.27450982</G><B>0.27450982</B></Color3>
			<token name="Technology">3</token>
		</Properties>
	</Item>
	<Item class="TextChatService" referent="RBX6">
		<Properties>
			<string name="Name">TextChatService</string>
			<token name="ChatVersion">1</token>
			<bool name="CreateDefaultTextChannels">true</bool>
			<bool name="CreateDefaultCommands">true</bool>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX7">
		<Properties><string name="Name">StarterPlayer</string></Properties>
		<Item class="StarterPlayerScripts" referent="RBX8">
			<Properties><string name="Name">StarterPlayerScripts</string></Properties>
			<Item class="LocalScript" referent="RBX9">
				<Properties>
					<string name="Name">ClientProbe</string>
					<ProtectedString name="Source"><![CDATA[print("[ClientProbe] LocalScript running")
-- Text measuring, which bubble chat sizes its bubbles with (the chat window does not).
local TS = game:GetService("TextService")
local TCS = game:GetService("TextChatService")
print("[ClientProbe] chat", TCS.ChatVersion.Name, TCS:FindFirstChildOfClass("BubbleChatConfiguration") ~= nil)
TCS.MessageReceived:Connect(function(m) print("[ClientProbe] message", m.Text, m.Status.Name) end)
for _, f in { Enum.Font.Legacy, Enum.Font.SourceSans, Enum.Font.BuilderSans, Enum.Font.GothamMedium } do
	task.spawn(function()
		print("[ClientProbe] GetTextSize start", f.Name)
		print("[ClientProbe] GetTextSize", f.Name, pcall(TS.GetTextSize, TS, "hello world", 16, f, Vector2.new(1000, 1000)))
	end)
end
task.spawn(function()
	local p = Instance.new("GetTextBoundsParams")
	p.Text = "hello world"; p.Size = 16; p.Width = 1000
	p.Font = Font.fromEnum(Enum.Font.BuilderSans)
	print("[ClientProbe] GetTextBoundsAsync start")
	print("[ClientProbe] GetTextBoundsAsync", pcall(TS.GetTextBoundsAsync, TS, p))
end)
task.delay(5, function()
	local l = Instance.new("TextLabel")
	l.Text = "hello world"; l.Size = UDim2.fromOffset(300, 50); l.Parent = Instance.new("ScreenGui", game.Players.LocalPlayer.PlayerGui)
	task.wait(2)
	print("[ClientProbe] TextLabel bounds", l.TextBounds, l.TextFits)
end)
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local p = Players.LocalPlayer
UIS.InputBegan:Connect(function(i, gp) print("[ClientProbe] input", i.KeyCode.Name, i.UserInputType.Name, gp) end)
local ps = p:WaitForChild("PlayerScripts")
task.wait(3)
for _, c in ps:GetChildren() do print("[ClientProbe] PlayerScripts:", c.Name, c.ClassName) end
local pmi = ps:FindFirstChild("PlayerModule")
if pmi then
	local ok, pm = pcall(require, pmi)
	print("[ClientProbe] require PlayerModule:", ok, pm)
end
local ch = p.Character or p.CharacterAdded:Wait()
for _, c in ch:GetChildren() do if c:IsA("LuaSourceContainer") then print("[ClientProbe] character script:", c.Name, c.ClassName) end end
local h, root = ch:WaitForChild("Humanoid"), ch:WaitForChild("HumanoidRootPart")
while true do
	task.wait(1)
	print("[ClientProbe] pos", root.Position, "move", h.MoveDirection, "state", h:GetState().Name, "tracks", #h:GetPlayingAnimationTracks())
end
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
